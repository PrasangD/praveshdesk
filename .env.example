# All values are PUBLIC and baked into the site at build time.
# On Cloudflare Pages, set them under Settings > Variables and Secrets (Production),
# then redeploy after any change.

# Your live address. Free: https://<project>.pages.dev  (switch to your own domain later)
NEXT_PUBLIC_SITE_URL=https://praveshdesk.pages.dev
NEXT_PUBLIC_CONTACT_PHONE=+91 90000 00000
# Digits only, with country code, no + (used for wa.me links)
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000
NEXT_PUBLIC_CONTACT_EMAIL=yourname@gmail.com
NEXT_PUBLIC_FOUNDER_NAME=Your Name

# Google Apps Script web app URL (ends in /exec). See README > "Lead inbox".
# Leave empty during local development: submissions are then logged to the browser console.
NEXT_PUBLIC_LEADS_ENDPOINT=

# Optional spam protection (free): Cloudflare Turnstile site key. Leave empty to turn it off.
# If you set it, also add TURNSTILE_SECRET to the Apps Script's Script Properties.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
